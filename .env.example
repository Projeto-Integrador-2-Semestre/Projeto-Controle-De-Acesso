# URL base da API Back-End em Java (Spring Boot).
# Local: http://localhost:8080 | Publicada: a URL do serviço no Render
VITE_API_URL=http://localhost:8080

# true força os dados simulados (sem API), só para desenvolver a interface.
# Em `npm run dev` sem VITE_API_URL o modo simulado já liga sozinho; no build de produção, nunca.
VITE_USE_MOCK=false
